{
  // ==========================================================================
  //  Headroom 插件配置 —— 离线分发时只需要改这一个文件
  //  Headroom plugin config —— the only file to edit for an offline bundle
  // ==========================================================================
  //
  //  支持 // 与 /* */ 注释（本文件按 JSONC 解析），改完在控制台点击“重载配置”
  //  即可生效，无需重启 QwenPaw。
  //
  //  优先级（后面的覆盖前面的）：
  //    1. 内置默认值
  //    2. 本文件
  //    3. QwenPaw 配置 ~/.qwenpaw/config.json 里的 plugins.headroom
  //    4. 环境变量 HEADROOM_BASE_URL / HEADROOM_TIMEOUT_SECONDS 等
  //
  //  Priority (later wins): defaults -> this file -> plugins.headroom ->
  //  environment variables.

  "headroom": {
    // 👇👇👇 离线分发时把这里硬编码成你的 headroom proxy 地址 👇👇👇
    //      Hardcode your headroom proxy URL here for air-gapped installs.
    //      例 / e.g. "http://10.0.0.12:8787"  "http://headroom.internal:8787"
    "base_url": "http://127.0.0.1:8787",

    // 访问 headroom 的超时时间（秒）。内网慢的时候可以调大。
    "timeout_seconds": 5.0,

    // 是否沿用 HTTP(S)_PROXY 环境变量访问 headroom。
    // 默认 false：headroom 通常在本机或容器内网，走系统代理反而会超时。
    "use_env_proxy": false
  },

  "routing": {
    // 插件启动时是否自动把默认对话模型切到 headroom 代理。
    // 关闭后仍然可以在页面里手动点击“启用路由”。
    "enabled": true,

    // 在 QwenPaw 里创建的 provider id / 名称（模型选择器里看到的名字）。
    "provider_id": "headroom",
    "provider_name": "Headroom 压缩代理",

    // provider 的 base_url 拼接后缀：base_url + api_path。
    // OpenAI 兼容端口用 "/v1"；如果 headroom 直接挂在域名根上可以直接写 ""。
    "api_path": "/v1",

    // AgentScope 的模型实现。OpenAI 系保持 OpenAIChatModel；
    // 走 Anthropic 原生协议时改成 "AnthropicChatModel"。
    "chat_model": "OpenAIChatModel",

    // 路由到代理后使用哪个模型。
    // 留空 = 沿用当前默认模型（推荐，切代理不换模型）。
    "model": "",

    // model 为空时是否沿用当前默认模型。
    "adopt_active_model": true,

    // 转发给上游的 API Key。
    // 留空 = 复用当前 provider 的 Key（headroom 会把客户端的鉴权头原样透传，
    // 所以通常不需要在这里填）。
    "api_key": "",

    // 关闭路由时是否恢复原来的默认模型。
    "restore_on_disable": true,

    // 路由状态（上一版默认模型等）的落盘位置，留空 = ~/.qwenpaw/plugin-data/headroom/
    "state_file": ""
  },

  "ui": {
    // 节省页面自动刷新间隔（秒）。
    "refresh_seconds": 20,

    // 曲线图展示最近多少条请求。
    "history_limit": 60,

    // “打开 Headroom 仪表盘”按钮跳转的路径（相对 base_url）。
    "dashboard_path": "/dashboard"
  }
}
